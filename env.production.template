# Production environment variables for gridd.click
# -------------------------------------------------
# Next.js loads `.env.production` when `next build` runs with NODE_ENV=production.
# That filename is gitignored (see `.gitignore`). Copy this template:
#   copy env.production.template .env.production
# Or define the same keys in Vercel / your host (Project → Settings → Environment Variables).
#
# Client Firebase config is also hardcoded in `src/lib/firebase.ts`; NEXT_PUBLIC_* below
# overrides that when set (optional).

# Firebase (client — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server API routes only — keep secret)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (use live keys for real charges; Dashboard → Webhooks → URL: https://YOUR_DOMAIN/api/stripe/webhook → signing secret below)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Resend (optional)
RESEND_API_KEY=

# App URL (canonical site URL, e.g. https://gridd.click)
NEXT_PUBLIC_APP_URL=

# Google Maps (Places / maps widgets)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Shipday (last-mile — optional; paid jobs with pickup + drop addresses sync to Shipday)
# Webhook URL: https://YOUR_DOMAIN/api/shipday/webhook — set validation token in Shipday to match SHIPDAY_WEBHOOK_TOKEN
SHIPDAY_API_KEY=
SHIPDAY_WEBHOOK_TOKEN=
# Used when a job has dropoff but no pickup.address (e.g. dispatch hub)
SHIPDAY_DEFAULT_PICKUP_ADDRESS=

# Internal / optional
NOTIFY_INTERNAL_SECRET=
GRIDD_CALL_BRIDGE_E164=
NEXT_PUBLIC_GRIDD_CALL_BRIDGE_E164=
